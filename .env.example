# Trading Terminal — landing hub configuration.
# Copy to .env and fill in the deployed URL for each tool. Any unset value leaves
# that card unlinked (it shows a "Set <VAR>" hint on the card).

SITE_NAME=Trading Terminal

# Deployed URLs for each tool (leave blank until deployed).
MORNING_BRIEF_URL=
STOCK_DEEPDIVE_URL=
SPY_POWER_HOUR_URL=
THIN_ZONE_URL=
OPTIONS_FLOW_URL=

# Local dev port (Railway sets PORT automatically).
# PORT=8000
