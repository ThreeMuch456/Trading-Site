# Trading Desk — configuration. Copy to .env and fill in as sources come online.
# With NO source URLs set, the desk runs in sample mode (renders the mock snapshot).
# Each source is independent and fails soft on its own.

SITE_NAME=Trading Desk

# ── Upstream sources (Phase 1 wires agent + zerodte) ──────────────────────────
# Trading-Agent (Morning Brief) — public /api/brief.json, /api/performance.json
AGENT_URL=
AGENT_TOKEN=

# 0DTE-Assistant (levels/regime) — /api/state, X-App-Token if APP_TOKEN set upstream
ZERO_DTE_URL=
ZERO_DTE_TOKEN=

# Options-Flow-Scanner (short-dated index flow) — /api/index-etfs[/waves|/eod]
FLOW_URL=
FLOW_TOKEN=

# Structure-Identifier (scored thin-zone recs) — /api/recs.json, EXPORT_TOKEN if set upstream
STRUCTURE_URL=
STRUCTURE_TOKEN=

# Stock-Analysis (quant scorecard, enriches the recs table) — /api/analyze?ai=0
STOCK_URL=
STOCK_TOKEN=

# Rotation column on the recs table reuses FLOW_URL (OFS /api/rotation) — no extra var.

# ── Tuning ────────────────────────────────────────────────────────────────────
# DESK_FETCH_TIMEOUT=4   # seconds per upstream call
# DESK_CACHE_TTL=60      # seconds a composed snapshot is served before refetch
# TICKERS=SPY,QQQ,IWM
# APP_TOKEN=             # gate the public desk URL (Phase 5)
# PORT=8000

# ── Learning store + scheduler ────────────────────────────────────────────────
# DESK_SCHEDULER=1       # enable cadence refresh (09:35 / 15-min / 16:15 ET); one worker only
# DESK_TZ=America/New_York
# DESK_DB_PATH=data/desk.sqlite3   # the desk journal (attach a Railway volume to persist it)
