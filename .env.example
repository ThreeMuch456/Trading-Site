# Trading Desk — configuration (UNIFIED single-deploy build).
#
# The desk now runs everything in ONE process: the six tools' compute is vendored
# into the `engines/` package and the desk calls Massive directly. There are no
# upstream service URLs any more. With MASSIVE_API_KEY unset the desk renders sample
# data; set it and each engine comes online as it is ported (see BUILD-PLAN.md).

SITE_NAME=Trading Desk

# ── Market data (the one key that turns the desk live) ────────────────────────
MASSIVE_API_KEY=
# MASSIVE_BASE_URL=https://api.massive.com
# MASSIVE_RPM=5                 # account-wide request budget (Starter answers ~5/min)
# MASSIVE_HTTP_TIMEOUT=20

# ── Other provider keys (per engine) ──────────────────────────────────────────
# ANTHROPIC_API_KEY=            # Morning Brief (agent) + optional stock AI read
# FRED_API_KEY=                 # macro calendar for the Morning Brief

# ── Tuning ────────────────────────────────────────────────────────────────────
# TICKERS=SPY,QQQ,IWM
# DESK_FETCH_TIMEOUT=4          # seconds per engine produce()
# DESK_CACHE_TTL=60             # seconds a composed snapshot is served before recompute
# APP_TOKEN=                    # gate the public desk URL (then open it at ?token=…)
# PORT=8000

# ── Learning store + scheduler ────────────────────────────────────────────────
# DESK_SCHEDULER=1              # cadence refresh (09:35 / 15-min / 16:15 ET); ONE worker only
# DESK_TZ=America/New_York
# DESK_DATA_DIR=data            # one Railway volume holds every engine's SQLite file
# DESK_DB_PATH=data/desk.sqlite3   # the compose-layer journal
